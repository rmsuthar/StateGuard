{
    "name": "@rsuthar/state-guard-js",
    "version": "2.1.0",
    "description": "Proactive DOM attribute protection library.",
    "license": "MIT",
    "author": "Ravindra M Suthar",
    "keywords": [
        "dom-protection",
        "security",
        "mutation-observer",
        "tamper-protection",
        "ui-security",
        "javascript-security",
        "react-security",
        "angular-security",
        "state-guard",
        "client-side-security",
        "typescript"
    ],
    "main": "dist/state-guard.min.js",
    "types": "src/StateGuard.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "jest --forceExit --detectOpenHandles",
        "build": "mkdir -p dist && terser src/StateGuard.js -o dist/state-guard.min.js --compress --mangle --comments '/^!/'",
        "obfuscate": "javascript-obfuscator src/StateGuard.js --output dist/state-guard.obf.js --self-defending true",
        "version": "node scripts/sync-version.js && npm run build && npm run obfuscate && git add src/StateGuard.js dist",
        "release": "npm test && npm run test:types && npm version minor",
        "test:types": "tsc -p tests/types/tsconfig.json"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/tests/types/"
        ]
    },
    "devDependencies": {
        "javascript-obfuscator": "^4.0.0",
        "jest": "^29.0.0",
        "jest-environment-jsdom": "^29.0.0",
        "terser": "^5.15.0",
        "typescript": "^5.9.3"
    }
}
